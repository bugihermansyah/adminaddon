APP_NAME="Admin Addon SAP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Local Filament account created by the initial user migration.
FILAMENT_ADMIN_EMAIL=admin@example.com
FILAMENT_ADMIN_USERNAME=admin
FILAMENT_ADMIN_PASSWORD=admin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Extra database connections use DB_HOST, DB_PORT, DB_USERNAME, DB_PASSWORD,
# and DB_SOCKET above; each selects its own schema in config/database.php.

# Comma-separated CSV URLs. The filename (for example PEI-P01494.csv) is used
# to scope resident updates and removals through penghuni.csv_name.
# RESIDENT_CSV_URLS="https://sales.paramount-land.com/api/v1/files/estate/gate/PEI-P01494.csv,https://sales.paramount-land.com/api/v1/files/estate/gate/PI-28980.csv"
# RESIDENT_CSV_INTERVAL_MINUTES=60
# per_file = all-or-nothing per csv_name; all_files = all configured URLs together.
# RESIDENT_CSV_ATOMICITY=per_file
# RESIDENT_CSV_MAX_BYTES=26214400

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
